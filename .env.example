# Neon (Vercel Marketplace store moravel-athletic-db). Pull real values with `vercel env pull .env.local`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Indexing gates (off unless explicitly enabled)
NEXT_PUBLIC_ENABLE_INDEXING=
NEXT_PUBLIC_ALLOW_AI_TRAINING=
NEXT_PUBLIC_SITE_URL=

# Optional bot check on checkout
TURNSTILE_SECRET_KEY=

# Email sending is DORMANT until both are set (see docs/email-and-list.md)
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=

# Optional, consent-gated PostHog analytics. Public ingest token, never a personal API key.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=false
